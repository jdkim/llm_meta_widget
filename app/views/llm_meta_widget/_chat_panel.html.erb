<%# Renders the widget as a custom element. Everything that used to live here — %>
<%# 360 lines of CSS, 21 lines of markup and 1,450 lines of script — moved into %>
<%# app/assets/javascripts/llm_meta_widget/element.js and is bundled into one %>
<%# ES module, so a non-Rails host can use the same widget with two lines of %>
<%# HTML. See docs/custom-element-distribution.md. %>
<%# %>
<%# Render via the llm_meta_widget helper, which maps its keyword options onto %>
<%# the attributes below — see app/helpers/llm_meta_widget/widget_helper.rb. %>
<%# %>
<%# The host page must still provide, because these belong to the host and not %>
<%# to the element: %>
<%#   (a) a JSON schema block with id = actions_schema_id, listing the local %>
<%#       action set (name/description/input_schema each). %>
<%#   (b) window.aiState — reader functions called each turn. %>
<%#   (c) window.aiActions — action implementations invoked after the LLM turn. %>
<%# %>
<%# NOTE on ERB comments: DO NOT consolidate these lines into one <%_# ... %_> %>
<%# block. Rails-ERB comment blocks terminate at the FIRST closing `%_>`, so %>
<%# any nested <%_= ... %_> inside cuts them short and the trailing lines leak %>
<%# into rendered HTML. One line per comment keeps them self-terminating. %>
<script type="module" src="<%= element_path %>"></script>
<llm-meta-widget
  llm-url="<%= llm_url %>"
  model="<%= model %>"
  <%= tag_attr("tool-hub-url", tool_hub_url) %>
  <%= tag_attr("llm-provider", llm_provider) %>
  <%= tag_attr("api-key-uuid", api_key_uuid) %>
  <%= tag_attr("greeting", greeting) %>
  <%= tag_attr("max-rounds", max_rounds) %>
  <%= tag_attr("actions-schema-id", actions_schema_id) %>
  <%= tag_attr("state-global", state_global) %>
  <%= tag_attr("actions-global", actions_global) %>
  <%= tag_attr("remote-tools-schema-id", remote_tools_schema_id) %>
  <%# Pickers default to true in the element, so only emit the disabling value. %>
  <%= enable_model_picker ? "" : 'enable-model-picker="false"'.html_safe %>
  <%= enable_tool_picker ? "" : 'enable-tool-picker="false"'.html_safe %>
  <%# Allowlists: nil omits the attribute, which the element reads as "no %>
  <%# allowlist". An empty array would mean the same thing, so it omits too. %>
  <%= tag_attr("models", Array(models).join(",").presence) %>
  <%= tag_attr("hub-tools", Array(hub_tools).join(",").presence) %>
  <%# well-known-urls is tri-state and this is the mapping that preserves it: %>
  <%#   nil   -> attribute omitted  -> auto-discover same-origin %>
  <%#   []    -> well-known-urls="" -> discovery off %>
  <%#   [a,b] -> "a,b"              -> fetch those %>
  <%= well_known_attr(well_known_urls) %>
></llm-meta-widget>
